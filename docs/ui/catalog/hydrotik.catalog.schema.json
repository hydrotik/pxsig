{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydrotik.dev/schema/llm/catalog.schema.json",
  "title": "Component catalog",
  "description": "docs/llm/catalog.json, generated by `hy-ai catalog` (pnpm llm:all): one record per component family of @hydrotik/design-system, for mapping a custom UI onto it. Checked against this schema before it is written.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$description",
    "schemaVersion",
    "systems",
    "components",
    "collisions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$description": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "systems": {
      "description": "The other design systems, by the key used in `aliases`: name, package version, source, and whether it is still maintained (`archived` systems still map, but a new UI should not adopt them).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "source",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "archived"
            ]
          },
          "statusNote": {
            "type": "string"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "parts",
          "import",
          "summary",
          "tags",
          "aliases"
        ],
        "properties": {
          "name": {
            "description": "The family's component, or the folder name for a family of several (Chart, Form).",
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "parts": {
            "description": "The other components of the family.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "import": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package",
              "subpath"
            ],
            "properties": {
              "package": {
                "type": "string"
              },
              "subpath": {
                "type": "string"
              }
            }
          },
          "summary": {
            "description": "What it is: the first sentence of the context file's Purpose.",
            "type": "string"
          },
          "use": {
            "description": "When to use it and what to use instead: the rest of the Purpose.",
            "type": "string"
          },
          "deprecated": {
            "const": true
          },
          "internal": {
            "description": "Classified internal in docs/guidance/classification.json: not for apps.",
            "const": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aliases": {
            "description": "The equivalent component in other design systems, by the keys in `systems`: name, doc url, what it does, how well it matches, and a note when it differs.",
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "url",
                  "does",
                  "match"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "does": {
                    "description": "What the component does, one line in our own words.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 140,
                    "pattern": "^[^\\n]+$"
                  },
                  "match": {
                    "enum": [
                      "equivalent",
                      "close",
                      "partial"
                    ]
                  },
                  "note": {
                    "description": "How it differs, or which other component covers the gap. Required unless the match is equivalent.",
                    "type": "string",
                    "minLength": 1
                  }
                },
                "if": {
                  "properties": {
                    "match": {
                      "const": "equivalent"
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "note"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "note"
                  ]
                }
              }
            }
          },
          "context": {
            "type": "string"
          },
          "stories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "usedBy": {
            "description": "Tools built on this family (pxsig: its dashboard adapter, docs/llm/pxsig-uses.json).",
            "type": "array",
            "items": {
              "enum": [
                "pxsig"
              ]
            }
          },
          "pxsigParts": {
            "description": "Which of the family's components pxsig uses.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "collisions": {
      "description": "Alias names (compared without case) that point at more than one hydrotik family across systems, e.g. Dropdown is Select in Carbon and Fluent but DropdownMenu in Ant and Bootstrap. Each family lists the systems that use the name for it, with what that component does.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "families"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "families": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "family",
                "systems"
              ],
              "properties": {
                "family": {
                  "type": "string"
                },
                "systems": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "system",
                      "name",
                      "does",
                      "match"
                    ],
                    "properties": {
                      "system": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "does": {
                        "type": "string"
                      },
                      "match": {
                        "enum": [
                          "equivalent",
                          "close",
                          "partial"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
