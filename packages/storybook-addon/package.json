{
  "name": "@pxsig/storybook-addon",
  "version": "0.7.6",
  "description": "pxsig in Storybook: a visual-regression panel and sidebar statuses, fed by the pxsig server; on a deployed Storybook, a read-only snapshot.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hydrotik/pxsig.git",
    "directory": "packages/storybook-addon"
  },
  "homepage": "https://github.com/hydrotik/pxsig#readme",
  "bugs": {
    "url": "https://github.com/hydrotik/pxsig/issues"
  },
  "author": "Donovan Adams (Hydrotik LLC)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "preset.mjs",
  "exports": {
    ".": "./preset.mjs",
    "./preset": "./preset.mjs"
  },
  "files": [
    "preset.mjs",
    "manager.mjs",
    "panel-style.mjs",
    "server-pick.mjs",
    "snapshot-view.mjs",
    "test/installed",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "storybook": ">=10"
  },
  "peerDependenciesMeta": {
    "storybook": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
