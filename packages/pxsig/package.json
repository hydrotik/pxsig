{
  "name": "pxsig",
  "version": "0.6.0",
  "description": "Visual regression for Storybook: compact pixel signatures with their baseline images, a Rust engine, a dashboard, a Storybook addon and an MCP server.",
  "license": "MIT",
  "author": "Donovan Adams (Hydrotik LLC)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hydrotik/pxsig.git",
    "directory": "packages/pxsig"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pxsig": "bin/pxsig.mjs"
  },
  "exports": {
    "./workspace": "./src/lib/workspace.mjs",
    "./psig": "./src/lib/psig.mjs",
    "./dashboard": {
      "types": "./dashboard/src/ui/contract.ts",
      "default": "./dashboard/src/ui/contract.ts"
    },
    "./diff-viewer": {
      "types": "./dashboard/src/diff-viewer/index.ts",
      "default": "./dashboard/src/diff-viewer/index.ts"
    },
    "./ui/catalog/hydrotik.json": "./docs/ui/catalog/hydrotik.catalog.json",
    "./ui/catalog/hydrotik.schema.json": "./docs/ui/catalog/hydrotik.catalog.schema.json",
    "./ui/catalog/hydrotik.source.json": "./docs/ui/catalog/hydrotik.catalog.source.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "dist",
    "dashboard",
    "docs",
    "README.md"
  ],
  "scripts": {
    "prepack": "node ../../scripts/sync-dashboard-source.mjs",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage \"--test-coverage-include=src/**\" --test-coverage-lines=85 --test-coverage-branches=74 --test-coverage-functions=82 test/*.test.mjs"
  },
  "dependencies": {
    "axe-core": "^4.10.0",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
