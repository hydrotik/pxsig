# Build output
/target/
node_modules/
dist/
packages/cli-*/
# Copied into the pxsig package at pack time (scripts/sync-dashboard-source.mjs)
packages/pxsig/dashboard/
packages/pxsig/docs/
# The root LICENSE, copied into each published package at pack time (sync-dashboard-source.mjs,
# pack-manifest.mjs)
packages/pxsig/LICENSE
packages/storybook-addon/LICENSE

# Anything a run produces: stores, baselines, renders, diffs, reports (they belong to the project
# under test, never to this repository; scripts/check-clean.mjs enforces it)
.pxsig/
__pxsig__/
*.psig
*.pxsig.json
# …but pxsig's own baselines: the dashboard screens' store keeps what a project commits
# (scripts/screens-check.mjs; check-clean.mjs allows exactly these)
!packages/dashboard/.pxsig/
packages/dashboard/.pxsig/*
!packages/dashboard/.pxsig/manifest.json
!packages/dashboard/.pxsig/approvals.ndjson
!packages/dashboard/.pxsig/baselines/
!packages/dashboard/.pxsig/baselines/**/*.psig
pxsig-diff/
.baselines/
.renders/
.reports/
.cache/
.conformance/
px-diff-out/
report/

# Images and binaries: tests synthesise theirs
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.woff
*.woff2
*.wasm
# …except product screenshots for the README and docs (check-clean allows images there, nowhere else)
!docs/product-shots/*.png
!docs/product-shots/*.jpg
!docs/product-shots/*.jpeg
!docs/product-shots/*.gif
!docs/product-shots/*.webp
!docs/product-shots/*.avif

# Local (.local/: private notes and reference material, never committed; check-clean enforces it)
.local/
.DS_Store
.idea/
.vscode/
.env*
.clean-terms
