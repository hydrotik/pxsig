{
  "name": "pxsig-repo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:rust": "cargo build --release",
    "build:dashboard": "pnpm --filter @pxsig/dashboard build",
    "test": "cargo test --workspace && pnpm --filter pxsig test",
    "test:examples": "node scripts/examples-test.mjs",
    "check:clean": "node scripts/check-clean.mjs && node --test scripts/check-clean.test.mjs",
    "ui:manifest": "node scripts/ui.mjs manifest",
    "ui:gaps": "node scripts/ui.mjs gaps",
    "ui:docs": "node scripts/ui.mjs docs",
    "ui:check": "node scripts/ui.mjs check",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.1",
      "vite-node": "^3.2.4"
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "typescript": "^5.9.3"
  }
}
