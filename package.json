{
  "name": "pxsig-repo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:rust": "cargo build --release",
    "build:dashboard": "pnpm --filter @pxsig/dashboard build",
    "test": "cargo test --workspace --locked && pnpm -r test && node --test scripts/*.test.mjs",
    "test:examples": "node scripts/examples-test.mjs",
    "check:clean": "node scripts/check-clean.mjs && node --test scripts/check-clean.test.mjs",
    "changelog:check": "node scripts/changelog.mjs check --since origin/main && node --test scripts/changelog.test.mjs",
    "changelog:preview": "node scripts/changelog.mjs preview",
    "ui:manifest": "node scripts/ui.mjs manifest",
    "ui:gaps": "node scripts/ui.mjs gaps",
    "ui:docs": "node scripts/ui.mjs docs",
    "ui:check": "node scripts/ui.mjs check",
    "ui:lock": "node scripts/ui.mjs lock",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "oxlint --type-aware",
    "lint:ratchet": "node scripts/check-lint-warnings.mjs && node --test scripts/lint-ratchet.test.mjs",
    "lint:workspace": "sherif",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.3.5",
      "vite-node": "^6.0.0"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "^0.3.25",
    "sherif": "^1.13.0",
    "typescript": "^5.9.3"
  }
}
